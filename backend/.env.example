# BloodBridge backend configuration (copy to .env and adjust)
# All variables use the BLOODBRIDGE_ prefix.

# SQLite for local dev. Use a postgres:// URL in production.
BLOODBRIDGE_DATABASE_URL=sqlite:///./bloodbridge.db

# Change this in any shared deployment.
BLOODBRIDGE_AUTH_SECRET=change-me-to-a-long-random-string

# Public base URL used to build referral / tracking links.
BLOODBRIDGE_APP_BASE_URL=http://localhost:5173

# Optional AI provider (assistant runs in deterministic demo mode without it).
# BLOODBRIDGE_GEMINI_API_KEY=your-key
# BLOODBRIDGE_GEMINI_MODEL=gemini-2.0-flash

# Optional official WhatsApp Business Cloud API.
# BLOODBRIDGE_WHATSAPP_ACCESS_TOKEN=your-token
# BLOODBRIDGE_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# BLOODBRIDGE_WHATSAPP_VERIFY_TOKEN=choose-a-verify-token

# Optional online geocoding via Nominatim (off by default).
# BLOODBRIDGE_ENABLE_NOMINATIM=false
